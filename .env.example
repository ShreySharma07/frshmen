# Settings for the Python pipeline (scripts/fetch_jobs.py). Copy to .env for local runs (never commit
# .env). In CI they come from the repo's Actions secrets (.github/workflows/pipeline.yml).
# The site's own settings are in site/.env.example.

# Free Himalayas API key (sources/himalayas.py): sign up at https://himalayas.app/signup/developer,
# then copy it from https://himalayas.app/api-keys. Actions secret HIMALAYAS_API_KEY.
# Unset: the board still works, with Himalayas' lower keyless limits.
HIMALAYAS_API_KEY=<api key>
