# Build-time settings for the site. Copy to .env.local for local builds (never commit .env.local).
# In CI they come from the repo's Actions variables (.github/workflows/deploy.yml). All three end up
# in the page's JavaScript, so none is a secret, but none belongs in the source either.

# Supabase project URL and publishable key (src/lib/supabase.ts). Unset: sign-in is off.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# Cloudflare Web Analytics site token (src/app/layout.tsx): the "token" in Cloudflare's beacon
# snippet (Web Analytics > Manage site). Repo variable CF_BEACON_TOKEN. Unset: no analytics.
NEXT_PUBLIC_CF_BEACON_TOKEN=<site token>
