{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frshmen",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["python_workers"],
  // Workers Logs (free tier): tracebacks from the API show up in the dashboard.
  "observability": { "enabled": true },
  // Supabase Postgres through Hyperdrive's connection pool (M3). The password lives in the
  // Hyperdrive config on Cloudflare, not here; the ID alone grants nothing.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "57f743f973844bb2b339af1278604312" }
  ],
  "assets": {
    // The React build. Served without running Python, so page loads don't use Worker requests.
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
