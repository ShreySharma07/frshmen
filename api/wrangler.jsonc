{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frshmen",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["python_workers"],
  // Workers Logs (free tier): tracebacks from the API show up in the dashboard.
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frshmen",
      // D1 database IDs are not secret; access needs the API token.
      "database_id": "e711a274-e62b-4f4f-8eda-94151348814e",
      "migrations_dir": "../db/migrations"
    }
  ],
  "assets": {
    // The React build. Served without running Python, so page loads don't use Worker requests.
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
