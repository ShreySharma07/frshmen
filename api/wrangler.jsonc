{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aventra",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["python_workers"],
  // Workers Logs (free tier): tracebacks from the API show up in the dashboard.
  "observability": { "enabled": true },
  // Gemini fit checks for signed-in people, 5 a day (docs/decisions.md, 2026-11-04). Needs the
  // GEMINI_API_KEY secret too; without it the check stays hidden.
  "vars": { "FIT_CHECK": "on" },
  // Supabase Postgres through Hyperdrive's connection pool (M3). The password lives in the
  // Hyperdrive config on Cloudflare, not here; the ID alone grants nothing.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "57f743f973844bb2b339af1278604312" }
  ],
  // Per-visitor limits in front of the API (api/src/edge.py; docs/decisions.md, 2026-11-18, M2).
  // Counted per IP in each Cloudflare location; period must be 10 or 60 seconds. The namespace ids
  // are ours to pick (unique in the account), not secrets.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1801", "simple": { "limit": 120, "period": 60 } },
    { "name": "AI_LIMITER", "namespace_id": "1802", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    // The Next.js static export (site/). Served without running Python, so page loads don't use
    // Worker requests. /design is served from design.html; unknown paths get out/404.html with a 404.
    "directory": "../site/out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
